<Window x:Class="MissionEditor.App.GameFolderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="Spielordner" Width="720" SizeToContent="Height" MinWidth="560"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
  <StackPanel Margin="28,20,28,24">
    <TextBlock Text="Spielordner" FontSize="22" FontWeight="SemiBold" />
    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0" LineHeight="20"
               Text="Aus diesem Freelancer-Ordner (der mit EXE\freelancer.ini) kommen die Nicknames für die Prüfung „unknown-game-nickname“ und die Texte hinter den IDS-Nummern. Gelesen werden die Dateien unter [Data] und [Resources] in freelancer.ini." />

    <RadioButton x:Name="AutomaticOption" GroupName="Folder" Margin="0,18,0,0" Checked="OnOptionChanged">
      <TextBlock Text="Automatisch: die Installation, in der die geöffnete Mission liegt" TextWrapping="Wrap" />
    </RadioButton>
    <RadioButton x:Name="FixedOption" GroupName="Folder" Margin="0,10,0,0" Checked="OnOptionChanged">
      <TextBlock Text="Diesen Ordner verwenden (z. B. bei mehreren Spielversionen oder Missionen außerhalb des Spielordners):" TextWrapping="Wrap" />
    </RadioButton>
    <DockPanel Margin="24,8,0,0">
      <Button DockPanel.Dock="Right" Content="Durchsuchen…" Click="OnBrowse" Margin="6,0,0,0" Padding="10,4" />
      <TextBox x:Name="FolderBox" FontFamily="Consolas" AutomationProperties.Name="Spielordner" TextChanged="OnFolderTyped" />
    </DockPanel>
    <DockPanel x:Name="RecentPanel" Margin="24,8,0,0">
      <TextBlock DockPanel.Dock="Left" Text="Zuletzt verwendet:" FontSize="12" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
      <ComboBox x:Name="RecentBox" FontFamily="Consolas" FontSize="12" SelectionChanged="OnRecentChosen" AutomationProperties.Name="Zuletzt verwendete Spielordner" />
    </DockPanel>
    <TextBlock x:Name="FolderStatus" FontSize="12" Margin="24,6,0,0" TextWrapping="Wrap" />

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,22,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="OkButton" Content="Übernehmen" IsDefault="True" Click="OnOk" FontWeight="SemiBold" Padding="14,6" Margin="0,0,8,0" />
        <Button Content="Abbrechen" IsCancel="True" Padding="14,6" />
      </StackPanel>
    </Border>
  </StackPanel>
</Window>
