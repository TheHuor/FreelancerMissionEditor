<Window x:Class="MissionEditor.App.MissionAdviceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="Frag KI" Width="980" Height="800" MinWidth="680" MinHeight="480"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
  <DockPanel Margin="24,18,24,20">
    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,14,0,0">
      <DockPanel>
        <Button DockPanel.Dock="Left" Content="KI-Einstellungen…" Click="OnSettings" Padding="12,6" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="CopyButton" Content="Kopieren" Click="OnCopy" Padding="12,6" Margin="0,0,8,0" IsEnabled="False" ToolTip="Die Antwort in die Zwischenablage kopieren" />
          <Button x:Name="AskAgainButton" Content="Erneut fragen" Click="OnAskAgain" Padding="12,6" Margin="0,0,8,0" />
          <Button Content="Schließen" IsCancel="True" Click="OnClose" Padding="14,6" />
        </StackPanel>
      </DockPanel>
    </Border>

    <StackPanel DockPanel.Dock="Top">
      <TextBlock x:Name="TitleText" FontSize="22" FontWeight="SemiBold" />
      <TextBlock x:Name="IntroText" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource MutedTextBrush}" />
      <DockPanel Margin="0,12,0,0">
        <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Abbrechen" Click="OnCancel" Padding="10,3" Margin="8,0,0,0" Visibility="Collapsed" />
        <ProgressBar x:Name="Progress" DockPanel.Dock="Right" Width="140" Height="6" IsIndeterminate="True" VerticalAlignment="Center" Visibility="Collapsed" />
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" />
      </DockPanel>
    </StackPanel>

    <TextBox x:Name="AnswerBox" Margin="0,14,0,0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
             FontSize="14" Padding="8" AutomationProperties.Name="Antwort" />
  </DockPanel>
</Window>
