<Window x:Class="MissionEditor.App.SimulationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="Ablauf durchspielen" Width="980" Height="720" MinWidth="680" MinHeight="420"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
  <DockPanel Margin="24,18,24,20">
    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,14,0,0">
      <DockPanel>
        <!-- A TextBlock as content: in a plain string WPF would take the "_" for an access key. -->
        <CheckBox x:Name="AutoTrueBox" DockPanel.Dock="Left" IsChecked="True" VerticalAlignment="Center" Checked="OnAutoTrueChanged" Unchecked="OnAutoTrueChanged">
          <TextBlock Text="Cnd_True sofort auslösen (wie im Spiel)" />
        </CheckBox>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="UndoButton" Content="Schritt zurück" Click="OnUndo" Padding="12,6" Margin="0,0,8,0" />
          <Button Content="Neu starten" Click="OnRestart" Padding="12,6" Margin="0,0,8,0" />
          <Button Content="Schließen" IsCancel="True" Click="OnClose" Padding="14,6" />
        </StackPanel>
      </DockPanel>
    </Border>

    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Ablauf durchspielen" FontSize="22" FontWeight="SemiBold" />
      <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource MutedTextBrush}"
                 Text="Links stehen die aktiven Trigger. „Auslösen“ tut so, als wäre ihre Bedingung eingetreten, und führt die Aktionen aus: Act_ActTrig aktiviert, Act_DeactTrig schaltet ab, ein Trigger ist danach erledigt (außer repeatable). Bedingungen selbst prüft der Editor nicht. Ein Klick wählt den Trigger im Hauptfenster aus." />
      <TextBlock x:Name="EndText" FontWeight="SemiBold" Margin="0,8,0,0" Visibility="Collapsed" />
    </StackPanel>

    <Grid Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="14" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <DockPanel Grid.Column="0">
        <TextBlock DockPanel.Dock="Top" x:Name="ActiveCaption" Foreground="{StaticResource MutedTextBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
        <ListBox x:Name="ActiveList" HorizontalContentAlignment="Stretch" SelectionChanged="OnActiveSelected" AutomationProperties.Name="Aktive Trigger">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <DockPanel Margin="2,4">
                <Button DockPanel.Dock="Right" Content="Auslösen" Click="OnFire" Padding="10,2" Margin="8,0,0,0" VerticalAlignment="Center" />
                <StackPanel>
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Detail}" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
      <DockPanel Grid.Column="2">
        <TextBlock DockPanel.Dock="Top" Text="PROTOKOLL" Foreground="{StaticResource MutedTextBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
        <ListBox x:Name="LogList" HorizontalContentAlignment="Stretch" SelectionChanged="OnLogSelected" AutomationProperties.Name="Protokoll">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="{Binding Indent}" FontWeight="{Binding Weight}" Foreground="{Binding Brush}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
