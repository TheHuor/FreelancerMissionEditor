<Window x:Class="MissionEditor.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:MissionEditor.App.Controls" xmlns:viewModels="clr-namespace:MissionEditor.App.ViewModels" Style="{StaticResource {x:Type Window}}" Title="{Binding WindowTitle}" Width="1400" Height="900" MinWidth="1120" MinHeight="700" WindowState="Maximized" AllowDrop="True" Drop="OnFileDrop" Closing="OnWindowClosing">
  <Window.DataContext>
    <viewModels:MainViewModel />
  </Window.DataContext>
  <Window.InputBindings>
    <KeyBinding Key="O" Modifiers="Ctrl" Command="{x:Static ApplicationCommands.Open}" />
    <KeyBinding Key="F5" Command="{x:Static NavigationCommands.Refresh}" />
    <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding BackCommand}" />
    <KeyBinding Key="F" Modifiers="Ctrl" Command="{x:Static NavigationCommands.Search}" />
    <KeyBinding Key="S" Modifiers="Ctrl" Command="{x:Static ApplicationCommands.Save}" />
    <KeyBinding Key="Z" Modifiers="Ctrl" Command="{Binding UndoCommand}" />
  </Window.InputBindings>
  <Window.CommandBindings>
    <CommandBinding Command="{x:Static ApplicationCommands.Open}" Executed="OnOpen" />
    <CommandBinding Command="{x:Static ApplicationCommands.SaveAs}" Executed="OnSaveAs" CanExecute="OnCanUseScript" />
    <CommandBinding Command="{x:Static ApplicationCommands.Save}" Executed="OnSave" CanExecute="OnCanSave" />
    <CommandBinding Command="{x:Static NavigationCommands.Refresh}" Executed="OnReload" CanExecute="OnCanUseScript" />
    <CommandBinding Command="{x:Static NavigationCommands.Search}" Executed="OnFocusFilter" />
  </Window.CommandBindings>
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <!-- List item with a clearly visible selection (also when the list has no focus): light blue
         background and a blue bar on the left. Background stays bindable for severity tints. -->
    <Style x:Key="ClearSelectionItem" TargetType="ListBoxItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="4,0,0,0" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectionBrush}" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource SelectionAccentBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Severity badge: red circle with a cross for errors, yellow triangle with "!" for warnings,
         grey circle with "i" for hints. Bound to BadgeKind of the DataContext. -->
    <ControlTemplate x:Key="SeverityBadge" TargetType="ContentControl">
      <Grid Width="16" Height="16">
        <Ellipse x:Name="ErrorShape" Fill="#C62828" Visibility="Collapsed" />
        <TextBlock x:Name="ErrorGlyph" Text="✕" Foreground="White" FontWeight="Bold" FontSize="10" FontFamily="Segoe UI" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
        <Path x:Name="WarningShape" Data="M8,0.5 L15.5,15 L0.5,15 Z" Fill="#FBC02D" Stroke="#E6A100" StrokeThickness="1" Visibility="Collapsed" />
        <TextBlock x:Name="WarningGlyph" Text="!" Foreground="#3E2723" FontWeight="Bold" FontSize="11" FontFamily="Segoe UI" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,0" Visibility="Collapsed" />
        <Ellipse x:Name="InfoShape" Fill="#9E9E9E" Visibility="Collapsed" />
        <TextBlock x:Name="InfoGlyph" Text="i" Foreground="White" FontWeight="Bold" FontSize="11" FontFamily="Segoe UI" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
      </Grid>
      <ControlTemplate.Triggers>
        <DataTrigger Binding="{Binding BadgeKind}" Value="Error">
          <Setter TargetName="ErrorShape" Property="Visibility" Value="Visible" />
          <Setter TargetName="ErrorGlyph" Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding BadgeKind}" Value="Warning">
          <Setter TargetName="WarningShape" Property="Visibility" Value="Visible" />
          <Setter TargetName="WarningGlyph" Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding BadgeKind}" Value="Info">
          <Setter TargetName="InfoShape" Property="Visibility" Value="Visible" />
          <Setter TargetName="InfoGlyph" Property="Visibility" Value="Visible" />
        </DataTrigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" TextDecorations="Underline" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8">
      <WrapPanel>
        <Button Style="{StaticResource {x:Type Button}}" Command="{x:Static ApplicationCommands.Open}" Content="Öffnen…" ToolTip="Missions-INI öffnen (Strg+O, oder Datei hineinziehen)" />
        <Button Style="{StaticResource {x:Type Button}}" Command="{x:Static NavigationCommands.Refresh}" Content="Neu laden" ToolTip="Datei neu laden und prüfen (F5)" />
        <Button Style="{StaticResource {x:Type Button}}" Command="{x:Static ApplicationCommands.Save}" Content="Speichern" ToolTip="Änderungen in die Datei schreiben (Strg+S); beim ersten Mal wird eine .bak-Sicherung angelegt" />
        <Button Style="{StaticResource {x:Type Button}}" Command="{x:Static ApplicationCommands.SaveAs}" Content="Speichern unter…" ToolTip="In eine andere Datei speichern" />
        <Button Style="{StaticResource {x:Type Button}}" Command="{Binding UndoCommand}" Content="↶ Rückgängig" ToolTip="Letzte Änderung zurücknehmen (Strg+Z)" />
        <Separator />
        <Button Style="{StaticResource {x:Type Button}}" Command="{Binding BackCommand}" Content="◀ Zurück" ToolTip="Zum vorher gewählten Trigger (Alt+←)" />
        <Button x:Name="AgentMenuButton" Content="KI-Agent ▾" Click="OnAgentMenu" Margin="12,0,0,0" ToolTip="Aufträge für Claude oder Codex kopieren und den MCP-Server einrichten">
          <Button.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Frag KI: Mission erklären" Click="OnAskAiToExplainMission" FontWeight="SemiBold" ToolTip="Die Antwort erscheint hier im Editor (Anbieter unter „KI-Einstellungen…“)" />
              <MenuItem Header="Frag KI: Lücken und Brüche" Click="OnAskAiForGapsAndBreaks" FontWeight="SemiBold" ToolTip="Die Antwort erscheint hier im Editor (Anbieter unter „KI-Einstellungen…“)" />
              <Separator />
              <MenuItem Header="Mission erklären lassen" Click="OnAskAgentToExplainMission" ToolTip="Auftrag kopieren: Ablauf und Geschichte der Mission in Spielreihenfolge erklären, mit den tragenden Triggern" />
              <MenuItem Header="Auf Lücken und Brüche prüfen lassen" Click="OnAskAgentForGapsAndBreaks" ToolTip="Auftrag kopieren: unerreichbare Trigger, Sackgassen, unmögliche Bedingungen und fehlende Pfade suchen" />
              <MenuItem Header="Alle Funde erklären lassen" Click="OnAskAgentForAllFindings" ToolTip="Auftrag kopieren: Funde der Mission zusammenfassen, erklären und Korrekturen vorschlagen" />
              <MenuItem Header="Neue Mission mit KI…" Click="OnAskAgentForNewMission" />
              <Separator />
              <MenuItem Header="Mit Datei vergleichen…" Click="OnCompareWithFile" ToolTip="Einen exportierten Entwurf (oder eine andere Fassung) abschnittsweise vergleichen und übernehmen" />
              <Separator />
              <MenuItem Header="KI-Agent verbinden…" Click="OnConnectAgent" />
              <MenuItem Header="KI-Einstellungen…" Click="OnAiSettings" />
            </ContextMenu>
          </Button.ContextMenu>
        </Button>
        <Button Content="Über…" Click="OnAbout" Margin="6,0,0,0" ToolTip="Versionen und Referenzen"/>
      </WrapPanel>
    </Border>
    <!-- Shown when another program (e.g. the AI agent) changed the open file on disk. -->
    <Border x:Name="ChangedOnDiskBanner" DockPanel.Dock="Top" Visibility="Collapsed" Background="{StaticResource WarningSurfaceBrush}"
            BorderBrush="{StaticResource WarningBrush}" BorderThickness="0,0,0,1" Padding="12,6">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Ignorieren" Click="OnIgnoreDiskChange" Margin="6,0,0,0" Padding="10,3" />
        <Button DockPanel.Dock="Right" Content="Neu laden" Click="OnReloadAfterDiskChange" Padding="10,3" FontWeight="SemiBold" />
        <TextBlock x:Name="ChangedOnDiskText" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" />
      </DockPanel>
    </Border>
    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem Content="{Binding StatusText}" />
    </StatusBar>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280" MinWidth="220" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition Width="*" MinWidth="360" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition Width="400" MinWidth="320" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" MinHeight="360" />
        <RowDefinition Height="5" />
        <RowDefinition x:Name="FindingsRow" Height="220" MinHeight="40" />
      </Grid.RowDefinitions>
      <!-- Trigger list -->
      <DockPanel Grid.Column="0" Grid.Row="0" Margin="8" Background="{StaticResource SurfaceBrush}">
        <TextBlock DockPanel.Dock="Top" Text="Trigger" Style="{StaticResource PanelHeading}" />
        <Label DockPanel.Dock="Top" Content="Trigger suchen" Target="{Binding ElementName=FilterBox}" Foreground="{StaticResource MutedTextBrush}" Padding="0,0,0,4" />
        <TextBox x:Name="FilterBox" DockPanel.Dock="Top" Margin="0,0,0,4" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=150}" ToolTip="Trigger filtern (Strg+F)" />
        <CheckBox DockPanel.Dock="Top" Margin="0,0,0,4" IsChecked="{Binding OnlyWithFindings}" Content="Nur Trigger mit Funden" ToolTip="Zeigt nur Trigger mit Funden ab der unten gewählten Schwere" />
        <ListBox x:Name="TriggerList" ItemsSource="{Binding TriggersView}" SelectedItem="{Binding SelectedTrigger}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" SelectionChanged="OnTriggerListSelectionChanged" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem" BasedOn="{StaticResource ClearSelectionItem}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding BadgeKind}" Value="Error">
                  <Setter Property="Background" Value="{StaticResource ErrorSurfaceBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding BadgeKind}" Value="Warning">
                  <Setter Property="Background" Value="{StaticResource WarningSurfaceBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="viewModels:TriggerItem">
              <DockPanel>
                <Button DockPanel.Dock="Right" Margin="4,0,0,0" Cursor="Hand" Click="OnFindingSignClicked" Visibility="{Binding HasFindings, Converter={StaticResource BoolToVisibility}}" ToolTip="{Binding FindingsToolTip}">
                  <Button.Template>
                    <ControlTemplate TargetType="Button">
                      <Border Background="Transparent" Padding="2">
                        <ContentControl Template="{StaticResource SeverityBadge}" />
                      </Border>
                    </ControlTemplate>
                  </Button.Template>
                </Button>
                <StackPanel>
                  <TextBlock x:Name="NameText" Text="{Binding Name}" ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Detail}" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DockPanel>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                  <Setter TargetName="NameText" Property="Foreground" Value="{StaticResource ErrorBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsInitiallyActive}" Value="True">
                  <Setter TargetName="NameText" Property="Foreground" Value="{StaticResource ActiveBrush}" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
      <GridSplitter Grid.Column="1" Grid.Row="0" Grid.RowSpan="1" HorizontalAlignment="Stretch" />
      <!-- Graph -->
      <DockPanel Grid.Column="2" Grid.Row="0" Margin="8,0">
        <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,8">
          <TextBlock Text="Zoom" VerticalAlignment="Center" />
          <Slider x:Name="ZoomSlider" Width="120" Minimum="0.1" Maximum="3" Value="1" Margin="4,0" VerticalAlignment="Center" />
          <TextBlock Width="40" VerticalAlignment="Center" Text="{Binding Value, ElementName=ZoomSlider, StringFormat={}{0:P0}}" />
          <Button Content="Einpassen" Padding="6,1" Margin="4,0" Click="OnZoomToFit" ToolTip="Ganzen Graph sichtbar machen" />
          <Button Content="100 %" Padding="6,1" Margin="0,0,12,0" Click="OnZoomReset" />
        </WrapPanel>
        <WrapPanel DockPanel.Dock="Top" Margin="6,4">
          <TextBlock Text="Rückwärts" VerticalAlignment="Center" />
          <ComboBox Width="64" Margin="4,0,12,0" SelectedItem="{Binding DepthBackward}" ItemsSource="{x:Static controls:GraphOptions.Depths}" />
          <TextBlock Text="Vorwärts" VerticalAlignment="Center" />
          <ComboBox Width="64" Margin="4,0,16,0" SelectedItem="{Binding DepthForward}" ItemsSource="{x:Static controls:GraphOptions.Depths}" />
          <CheckBox IsChecked="{Binding ShowActivate}" VerticalAlignment="Center" Margin="0,0,10,0">
            <StackPanel Orientation="Horizontal">
              <Path Data="M0,0 L20,0" Width="20" Height="4" VerticalAlignment="Center" Margin="0,0,4,0" Stroke="{x:Static controls:GraphOptions.ActivateBrush}" StrokeThickness="2" />
              <TextBlock Text="ActTrig" Foreground="{x:Static controls:GraphOptions.ActivateBrush}" />
            </StackPanel>
          </CheckBox>
          <CheckBox IsChecked="{Binding ShowWatch}" VerticalAlignment="Center" Margin="0,0,10,0">
            <StackPanel Orientation="Horizontal">
              <Path Data="M0,0 L20,0" Width="20" Height="4" VerticalAlignment="Center" Margin="0,0,4,0" Stroke="{x:Static controls:GraphOptions.WatchBrush}" StrokeThickness="2" StrokeDashArray="5,3" />
              <TextBlock Text="WatchTrigger" Foreground="{x:Static controls:GraphOptions.WatchBrush}" />
            </StackPanel>
          </CheckBox>
          <CheckBox IsChecked="{Binding ShowSave}" VerticalAlignment="Center" Margin="0,0,10,0">
            <StackPanel Orientation="Horizontal">
              <Path Data="M0,0 L20,0" Width="20" Height="4" VerticalAlignment="Center" Margin="0,0,4,0" Stroke="{x:Static controls:GraphOptions.SaveBrush}" StrokeThickness="2" StrokeDashArray="1,3" />
              <TextBlock Text="Save" Foreground="{x:Static controls:GraphOptions.SaveBrush}" />
            </StackPanel>
          </CheckBox>
          <CheckBox IsChecked="{Binding ShowDeactivate}" VerticalAlignment="Center" Margin="0,0,16,0">
            <StackPanel Orientation="Horizontal">
              <Path Data="M0,0 L20,0" Width="20" Height="4" VerticalAlignment="Center" Margin="0,0,4,0" Stroke="{x:Static controls:GraphOptions.DeactivateBrush}" StrokeThickness="2" StrokeDashArray="5,2,1,2" />
              <TextBlock Text="DeactTrig" Foreground="{x:Static controls:GraphOptions.DeactivateBrush}" />
            </StackPanel>
          </CheckBox>
          <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="{Binding HiddenNodeText}" />
        </WrapPanel>
        <Grid Background="{StaticResource GraphBackgroundBrush}">
          <ScrollViewer x:Name="GraphScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="Transparent" PreviewMouseWheel="OnGraphMouseWheel" PreviewMouseLeftButtonDown="OnGraphPanStart" PreviewMouseMove="OnGraphPanMove" PreviewMouseLeftButtonUp="OnGraphPanEnd" LostMouseCapture="OnGraphPanLost" ToolTip="Ziehen: verschieben · Mausrad: zoomen · Umschalt+Mausrad: waagerecht scrollen" ToolTipService.InitialShowDelay="1500">
            <controls:TriggerGraphCanvas x:Name="GraphCanvas" Layout="{Binding Layout}" NodeClicked="OnGraphNodeClicked" Redrawn="OnGraphRedrawn">
              <controls:TriggerGraphCanvas.LayoutTransform>
                <ScaleTransform ScaleX="{Binding Value, ElementName=ZoomSlider}" ScaleY="{Binding Value, ElementName=ZoomSlider}" />
              </controls:TriggerGraphCanvas.LayoutTransform>
            </controls:TriggerGraphCanvas>
          </ScrollViewer>
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Script}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </StackPanel.Style>
            <TextBlock Text="Mission öffnen" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="Missions-INI öffnen oder eine Datei hierher ziehen." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12" />
            <Button Content="Öffnen…" Command="{x:Static ApplicationCommands.Open}" HorizontalAlignment="Center" />
          </StackPanel>
        </Grid>
      </DockPanel>
      <GridSplitter Grid.Column="3" Grid.Row="0" Grid.RowSpan="1" HorizontalAlignment="Stretch" />
      <!-- Details -->
      <Grid Grid.Column="4" Grid.Row="0" Margin="6,4">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="0" />
          <RowDefinition Height="*" MinHeight="100" />
          <RowDefinition Height="5" />
          <RowDefinition Height="2*" MinHeight="160" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="{Binding DetailsTitle}" ToolTip="{Binding DetailsTitle}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Row="1" Text="{Binding SelectedSummary}" MaxHeight="48" ToolTip="{Binding SelectedSummary}" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,6" TextWrapping="Wrap" />
        <TabControl x:Name="DetailTabs" Grid.Row="2" Grid.RowSpan="2">
          <TabItem Header="{Binding SelectedFindingsHeader}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" FontWeight="Normal" Margin="0,4,0,0" TextElement.Foreground="{StaticResource TextBrush}">
              <ItemsControl x:Name="DetailFindings" ItemsSource="{Binding SelectedFindings}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="viewModels:FindingRow">
                    <Border x:Name="Box" Background="{StaticResource WarningSurfaceBrush}" BorderBrush="{StaticResource WarningBrush}" BorderThickness="3,0,0,0" Padding="6,3" Margin="0,0,0,3" Cursor="Hand" MouseLeftButtonUp="OnDetailFindingClicked" ToolTip="{Binding FullText}">
                      <StackPanel>
                        <DockPanel>
                          <Button DockPanel.Dock="Right" Content="Frag KI" Click="OnAskAiForDetailFinding" Padding="6,0" Margin="6,0,0,0" VerticalAlignment="Top" FontSize="12" ToolTip="Erklärung und Korrekturvorschlag direkt hier im Editor anzeigen" />
                          <ContentControl DockPanel.Dock="Left" Template="{StaticResource SeverityBadge}" Margin="0,1,6,0" VerticalAlignment="Top" />
                          <TextBlock TextWrapping="Wrap">
                            <Run Text="{Binding LineNumber, Mode=OneWay, StringFormat={}Zeile {0}:}" Foreground="{StaticResource MutedTextBrush}" />
                            <Run Text="{Binding Message, Mode=OneWay}" />
                          </TextBlock>
                        </DockPanel>
                        <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,3,0,0" Visibility="{Binding ShowHint, Converter={StaticResource BoolToVisibility}}" />
                      </StackPanel>
                    </Border>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding SeverityText}" Value="Fehler">
                        <Setter TargetName="Box" Property="Background" Value="{StaticResource ErrorSurfaceBrush}" />
                        <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding SeverityText}" Value="Hinweis">
                        <Setter TargetName="Box" Property="Background" Value="{StaticResource InputBrush}" />
                        <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource MutedTextBrush}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                        <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource SelectionAccentBrush}" />
                        <Setter TargetName="Box" Property="BorderThickness" Value="5,2,2,2" />
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="Verweise">
            <ListView ItemsSource="{Binding References}">
              <ListView.View>
                <GridView>
                  <GridViewColumn Header="Beziehung" Width="150" DisplayMemberBinding="{Binding Relation}" />
                  <GridViewColumn Header="Trigger" Width="170">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="viewModels:ReferenceItem">
                        <Button Style="{StaticResource LinkButton}" Content="{Binding OtherName}" Click="OnReferenceClicked" ToolTip="{Binding LineText}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="Zeile" Width="60" DisplayMemberBinding="{Binding LineNumber}" />
                </GridView>
              </ListView.View>
            </ListView>
          </TabItem>
        </TabControl>
        <GridSplitter Grid.Row="4" HorizontalAlignment="Stretch" />
        <DockPanel Grid.Row="5">
          <TextBlock DockPanel.Dock="Top" Text="Quelltext" Style="{StaticResource PanelHeading}" Margin="0,8" />
          <ListBox x:Name="SectionPreview" ItemsSource="{Binding SelectedSectionLines}" SelectionMode="Extended" MouseDoubleClick="OnSectionPreviewDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13" HorizontalContentAlignment="Stretch" KeyDown="OnSectionPreviewKeyDown" ToolTip="Strg+C kopiert die markierten Zeilen" ToolTipService.InitialShowDelay="2000">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem" BasedOn="{StaticResource ClearSelectionItem}">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate DataType="viewModels:SectionLineItem">
                <Border x:Name="Row" Background="Transparent" BorderThickness="3,0,0,0" BorderBrush="Transparent" ToolTip="{Binding ToolTip}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="54" />
                      <ColumnDefinition Width="20" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Column="0" Width="48" Text="{Binding NumberText}" Foreground="{StaticResource MutedTextBrush}" TextAlignment="Right" Margin="0,0,6,0" />
                    <ContentControl Grid.Column="1" Width="16" Margin="0,0,4,0" VerticalAlignment="Center" Template="{StaticResource SeverityBadge}" />
                    <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="4,1" Visibility="{Binding HasActions, Converter={StaticResource BoolToVisibility}}">
                      <Button Content="Bearbeiten" Padding="6,0" Margin="0,0,4,0" FontFamily="Segoe UI" Click="OnEditSection" ToolTip="Diesen Abschnitt im Textfenster bearbeiten" />
                      <Button Content="Löschen" Style="{StaticResource DangerButton}" Padding="6,0" FontFamily="Segoe UI" Click="OnDeleteSection" ToolTip="Diesen Abschnitt aus der Datei entfernen (Strg+Z macht es rückgängig)" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock x:Name="LineText" Text="{Binding Text}" TextWrapping="NoWrap" />
                      <!-- The text behind IDS numbers, from the resource DLLs of the game. -->
                      <TextBlock Text="{Binding NoteText}" Margin="16,0,0,0" FontFamily="Segoe UI" FontStyle="Italic" Foreground="{StaticResource MutedTextBrush}" TextWrapping="NoWrap"
                                 Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" ToolTip="Text aus den Ressourcen-DLLs des Spiels" />
                    </StackPanel>
                  </Grid>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsCaption}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource InputBrush}" />
                    <Setter TargetName="Row" Property="Margin" Value="0,6,0,2" />
                    <Setter TargetName="LineText" Property="FontFamily" Value="Segoe UI" />
                    <Setter TargetName="LineText" Property="FontWeight" Value="SemiBold" />
                    <Setter TargetName="LineText" Property="Foreground" Value="{StaticResource TextBrush}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding HasFindings}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource WarningSurfaceBrush}" />
                    <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource ErrorSurfaceBrush}" />
                    <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Grid>
      <GridSplitter Grid.Column="0" Grid.ColumnSpan="5" Grid.Row="1" HorizontalAlignment="Stretch" IsEnabled="{Binding IsExpanded, ElementName=FindingsExpander}" />
      <!-- Findings -->
      <Expander x:Name="FindingsExpander" Grid.Column="0" Grid.ColumnSpan="5" Grid.Row="2" Margin="8,0,8,8" Header="Prüfergebnisse" IsExpanded="True" Expanded="OnFindingsExpanded" Collapsed="OnFindingsCollapsed">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="Prüfungen – ab" VerticalAlignment="Center" FontWeight="SemiBold" />
            <ComboBox Width="100" Margin="6,0" ItemsSource="{Binding Severities}" SelectedValuePath="Key" SelectedValue="{Binding MinimumSeverity}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Value}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="Doppelklick öffnet die Fundstelle" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
          </StackPanel>
          <DataGrid x:Name="FindingsGrid" ItemsSource="{Binding FindingsView}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None" MouseDoubleClick="OnFindingDoubleClick" EnableRowVirtualization="True">
            <DataGrid.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Frag KI …" Click="OnAskAiForGridFinding" FontWeight="SemiBold" />
                <MenuItem Header="An KI-Agent übergeben (Auftrag kopieren)" Click="OnAskAgentForGridFinding" />
              </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Resources>
              <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#173C56" />
              <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#E4EDF5" />
              <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#173C56" />
              <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#E4EDF5" />
            </DataGrid.Resources>
            <DataGrid.RowStyle>
              <Style TargetType="DataGridRow">
                <Setter Property="ToolTip" Value="{Binding FullText}" />
                <Setter Property="BorderThickness" Value="4,0,0,0" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Style.Triggers>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource SelectionAccentBrush}" />
                  </Trigger>
                  <DataTrigger Binding="{Binding SeverityText}" Value="Fehler">
                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding SeverityText}" Value="Hinweis">
                    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
              <DataGridTemplateColumn Width="32" CanUserResize="False">
                <DataGridTemplateColumn.CellStyle>
                  <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                    <Setter Property="Padding" Value="0" />
                  </Style>
                </DataGridTemplateColumn.CellStyle>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <ContentControl Template="{StaticResource SeverityBadge}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Schwere" Binding="{Binding SeverityText}" Width="96" />
              <DataGridTextColumn Header="Zeile" Binding="{Binding LineNumber}" Width="60" />
              <DataGridTextColumn Header="Prüfung" Binding="{Binding CheckId}" Width="170" />
              <DataGridTextColumn Header="Betreff" Binding="{Binding Subject}" Width="200" />
              <DataGridTextColumn Header="Meldung" Binding="{Binding Message}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Expander>
    </Grid>
  </DockPanel>
</Window>
