<Window x:Class="MissionEditor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MissionEditor.App.Controls"
        xmlns:viewModels="clr-namespace:MissionEditor.App.ViewModels"
        Title="{Binding WindowTitle}" Width="1400" Height="900" WindowState="Maximized"
        AllowDrop="True" Drop="OnFileDrop" Closing="OnWindowClosing">
  <Window.DataContext>
    <viewModels:MainViewModel />
  </Window.DataContext>
  <Window.InputBindings>
    <KeyBinding Key="O" Modifiers="Ctrl" Command="{x:Static ApplicationCommands.Open}" />
    <KeyBinding Key="F5" Command="{x:Static NavigationCommands.Refresh}" />
    <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding BackCommand}" />
    <KeyBinding Key="F" Modifiers="Ctrl" Command="{x:Static NavigationCommands.Search}" />
    <KeyBinding Key="S" Modifiers="Ctrl" Command="{x:Static ApplicationCommands.Save}" />
    <KeyBinding Key="Z" Modifiers="Ctrl" Command="{Binding UndoCommand}" />
  </Window.InputBindings>
  <Window.CommandBindings>
    <CommandBinding Command="{x:Static ApplicationCommands.Open}" Executed="OnOpen" />
    <CommandBinding Command="{x:Static ApplicationCommands.SaveAs}" Executed="OnSaveAs" CanExecute="OnCanUseScript" />
    <CommandBinding Command="{x:Static ApplicationCommands.Save}" Executed="OnSave" CanExecute="OnCanSave" />
    <CommandBinding Command="{x:Static NavigationCommands.Refresh}" Executed="OnReload" CanExecute="OnCanUseScript" />
    <CommandBinding Command="{x:Static NavigationCommands.Search}" Executed="OnFocusFilter" />
  </Window.CommandBindings>
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#CCE4F7" />
    <SolidColorBrush x:Key="SelectionAccentBrush" Color="#1565C0" />
    <SolidColorBrush x:Key="HoverBrush" Color="#EAF3FB" />
    <!-- List item with a clearly visible selection (also when the list has no focus): light blue
         background and a blue bar on the left. Background stays bindable for severity tints. -->
    <Style x:Key="ClearSelectionItem" TargetType="ListBoxItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="4,2" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="4,0,0,0"
                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectionBrush}" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource SelectionAccentBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Severity badge: red circle with a cross for errors, yellow triangle with "!" for warnings,
         grey circle with "i" for hints. Bound to BadgeKind of the DataContext. -->
    <ControlTemplate x:Key="SeverityBadge" TargetType="ContentControl">
      <Grid Width="16" Height="16">
        <Ellipse x:Name="ErrorShape" Fill="#C62828" Visibility="Collapsed" />
        <TextBlock x:Name="ErrorGlyph" Text="✕" Foreground="White" FontWeight="Bold" FontSize="10" FontFamily="Segoe UI"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
        <Path x:Name="WarningShape" Data="M8,0.5 L15.5,15 L0.5,15 Z" Fill="#FBC02D" Stroke="#E6A100" StrokeThickness="1" Visibility="Collapsed" />
        <TextBlock x:Name="WarningGlyph" Text="!" Foreground="#3E2723" FontWeight="Bold" FontSize="11" FontFamily="Segoe UI"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,0" Visibility="Collapsed" />
        <Ellipse x:Name="InfoShape" Fill="#9E9E9E" Visibility="Collapsed" />
        <TextBlock x:Name="InfoGlyph" Text="i" Foreground="White" FontWeight="Bold" FontSize="11" FontFamily="Segoe UI"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
      </Grid>
      <ControlTemplate.Triggers>
        <DataTrigger Binding="{Binding BadgeKind}" Value="Error">
          <Setter TargetName="ErrorShape" Property="Visibility" Value="Visible" />
          <Setter TargetName="ErrorGlyph" Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding BadgeKind}" Value="Warning">
          <Setter TargetName="WarningShape" Property="Visibility" Value="Visible" />
          <Setter TargetName="WarningGlyph" Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding BadgeKind}" Value="Info">
          <Setter TargetName="InfoShape" Property="Visibility" Value="Visible" />
          <Setter TargetName="InfoGlyph" Property="Visibility" Value="Visible" />
        </DataTrigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="LinkButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="#1565C0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <TextBlock Text="{TemplateBinding Content}" TextDecorations="Underline" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <DockPanel>
    <ToolBarTray DockPanel.Dock="Top">
      <ToolBar>
        <Button Command="{x:Static ApplicationCommands.Open}" Content="Öffnen…" ToolTip="Missions-INI öffnen (Strg+O, oder Datei hineinziehen)" />
        <Button Command="{x:Static NavigationCommands.Refresh}" Content="Neu laden" ToolTip="Datei neu laden und prüfen (F5)" />
        <Button Command="{x:Static ApplicationCommands.Save}" Content="Speichern" ToolTip="Änderungen in die Datei schreiben (Strg+S); beim ersten Mal wird eine .bak-Sicherung angelegt" />
        <Button Command="{x:Static ApplicationCommands.SaveAs}" Content="Speichern unter…" ToolTip="In eine andere Datei speichern" />
        <Button Command="{Binding UndoCommand}" Content="↶ Rückgängig" ToolTip="Letzte Änderung zurücknehmen (Strg+Z)" />
        <Separator />
        <Button Command="{Binding BackCommand}" Content="◀ Zurück" ToolTip="Zum vorher gewählten Trigger (Alt+←)" />
      </ToolBar>
    </ToolBarTray>
    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem Content="{Binding StatusText}" />
    </StatusBar>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300" MinWidth="180" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="420" MinWidth="200" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="5" />
        <RowDefinition Height="220" MinHeight="60" />
      </Grid.RowDefinitions>

      <!-- Trigger list -->
      <DockPanel Grid.Column="0" Grid.Row="0" Margin="4">
        <TextBox x:Name="FilterBox" DockPanel.Dock="Top" Margin="0,0,0,4"
                 Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                 ToolTip="Trigger filtern (Strg+F)" />
        <CheckBox DockPanel.Dock="Top" Margin="0,0,0,4" IsChecked="{Binding OnlyWithFindings}"
                  Content="Nur Trigger mit Funden" ToolTip="Zeigt nur Trigger mit Funden ab der unten gewählten Schwere" />
        <ListBox x:Name="TriggerList" ItemsSource="{Binding TriggersView}" SelectedItem="{Binding SelectedTrigger}"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 SelectionChanged="OnTriggerListSelectionChanged" HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem" BasedOn="{StaticResource ClearSelectionItem}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding BadgeKind}" Value="Error">
                  <Setter Property="Background" Value="#FDECEA" />
                </DataTrigger>
                <DataTrigger Binding="{Binding BadgeKind}" Value="Warning">
                  <Setter Property="Background" Value="#FFF8E1" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="viewModels:TriggerItem">
              <DockPanel>
                <Button DockPanel.Dock="Right" Margin="4,0,0,0" Cursor="Hand" Click="OnFindingSignClicked"
                        Visibility="{Binding HasFindings, Converter={StaticResource BoolToVisibility}}"
                        ToolTip="{Binding FindingsToolTip}">
                  <Button.Template>
                    <ControlTemplate TargetType="Button">
                      <Border Background="Transparent" Padding="2">
                        <ContentControl Template="{StaticResource SeverityBadge}" />
                      </Border>
                    </ControlTemplate>
                  </Button.Template>
                </Button>
                <StackPanel>
                  <TextBlock x:Name="NameText" Text="{Binding Name}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Detail}" FontFamily="Consolas" FontSize="10.5" Foreground="Gray" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DockPanel>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                  <Setter TargetName="NameText" Property="Foreground" Value="Firebrick" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsInitiallyActive}" Value="True">
                  <Setter TargetName="NameText" Property="Foreground" Value="#2E7D32" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
      <GridSplitter Grid.Column="1" Grid.Row="0" Grid.RowSpan="3" HorizontalAlignment="Stretch" />

      <!-- Graph -->
      <DockPanel Grid.Column="2" Grid.Row="0">
        <WrapPanel DockPanel.Dock="Top" Margin="6,4">
          <TextBlock Text="Rückwärts" VerticalAlignment="Center" />
          <ComboBox Width="45" Margin="4,0,12,0" SelectedItem="{Binding DepthBackward}" ItemsSource="{x:Static controls:GraphOptions.Depths}" />
          <TextBlock Text="Vorwärts" VerticalAlignment="Center" />
          <ComboBox Width="45" Margin="4,0,16,0" SelectedItem="{Binding DepthForward}" ItemsSource="{x:Static controls:GraphOptions.Depths}" />
          <CheckBox IsChecked="{Binding ShowActivate}" VerticalAlignment="Center" Margin="0,0,10,0">
            <TextBlock Text="ActTrig" Foreground="{x:Static controls:GraphOptions.ActivateBrush}" FontWeight="SemiBold" />
          </CheckBox>
          <CheckBox IsChecked="{Binding ShowWatch}" VerticalAlignment="Center" Margin="0,0,10,0">
            <TextBlock Text="WatchTrigger" Foreground="{x:Static controls:GraphOptions.WatchBrush}" FontWeight="SemiBold" />
          </CheckBox>
          <CheckBox IsChecked="{Binding ShowSave}" VerticalAlignment="Center" Margin="0,0,10,0">
            <TextBlock Text="Save" Foreground="{x:Static controls:GraphOptions.SaveBrush}" FontWeight="SemiBold" />
          </CheckBox>
          <CheckBox IsChecked="{Binding ShowDeactivate}" VerticalAlignment="Center" Margin="0,0,16,0">
            <TextBlock Text="DeactTrig" Foreground="{x:Static controls:GraphOptions.DeactivateBrush}" FontWeight="SemiBold" />
          </CheckBox>
          <TextBlock Text="Zoom" VerticalAlignment="Center" />
          <Slider x:Name="ZoomSlider" Width="120" Minimum="0.1" Maximum="3" Value="1" Margin="4,0" VerticalAlignment="Center" />
          <TextBlock Width="40" VerticalAlignment="Center" Text="{Binding Value, ElementName=ZoomSlider, StringFormat={}{0:P0}}" />
          <Button Content="Einpassen" Padding="6,1" Margin="4,0" Click="OnZoomToFit" ToolTip="Ganzen Graph sichtbar machen" />
          <Button Content="100 %" Padding="6,1" Margin="0,0,12,0" Click="OnZoomReset" />
          <TextBlock VerticalAlignment="Center" Foreground="Gray"
                     Text="{Binding HiddenNodeText}" />
        </WrapPanel>
        <ScrollViewer x:Name="GraphScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Background="#FAFAFA" PreviewMouseWheel="OnGraphMouseWheel"
                      PreviewMouseLeftButtonDown="OnGraphPanStart" PreviewMouseMove="OnGraphPanMove"
                      PreviewMouseLeftButtonUp="OnGraphPanEnd" LostMouseCapture="OnGraphPanLost"
                      ToolTip="Ziehen: verschieben · Mausrad: zoomen · Umschalt+Mausrad: waagerecht scrollen"
                      ToolTipService.InitialShowDelay="1500">
          <controls:TriggerGraphCanvas x:Name="GraphCanvas" Layout="{Binding Layout}" NodeClicked="OnGraphNodeClicked" Redrawn="OnGraphRedrawn">
            <controls:TriggerGraphCanvas.LayoutTransform>
              <ScaleTransform ScaleX="{Binding Value, ElementName=ZoomSlider}" ScaleY="{Binding Value, ElementName=ZoomSlider}" />
            </controls:TriggerGraphCanvas.LayoutTransform>
          </controls:TriggerGraphCanvas>
        </ScrollViewer>
      </DockPanel>
      <GridSplitter Grid.Column="3" Grid.Row="0" Grid.RowSpan="3" HorizontalAlignment="Stretch" />

      <!-- Details -->
      <Grid Grid.Column="4" Grid.Row="0" Margin="6,4">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" MinHeight="80" />
          <RowDefinition Height="5" />
          <RowDefinition Height="2*" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="{Binding DetailsTitle}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Grid.Row="1" Text="{Binding SelectedSummary}" Foreground="Gray" Margin="0,2,0,6" TextWrapping="Wrap" />
        <Expander Grid.Row="2" Header="{Binding SelectedFindingsHeader}" IsExpanded="{Binding FindingsExpanded, Mode=TwoWay}" Margin="0,0,0,6" FontWeight="SemiBold"
                  Visibility="{Binding HasSelectedFindings, Converter={StaticResource BoolToVisibility}}">
          <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" FontWeight="Normal" Margin="0,4,0,0">
            <ItemsControl x:Name="DetailFindings" ItemsSource="{Binding SelectedFindings}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="viewModels:FindingRow">
                  <Border x:Name="Box" Background="#FFF8E1" BorderBrush="#F9A825" BorderThickness="3,0,0,0"
                          Padding="6,3" Margin="0,0,0,3" Cursor="Hand" MouseLeftButtonUp="OnDetailFindingClicked"
                          ToolTip="{Binding FullText}">
                    <StackPanel>
                      <DockPanel>
                        <ContentControl DockPanel.Dock="Left" Template="{StaticResource SeverityBadge}" Margin="0,1,6,0" VerticalAlignment="Top" />
                        <TextBlock TextWrapping="Wrap">
                          <Run Text="{Binding LineNumber, Mode=OneWay, StringFormat={}Zeile {0}:}" Foreground="Gray" />
                          <Run Text="{Binding Message, Mode=OneWay}" />
                        </TextBlock>
                      </DockPanel>
                      <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" Foreground="#555" FontSize="11.5" Margin="0,3,0,0"
                                 Visibility="{Binding ShowHint, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                  </Border>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding SeverityText}" Value="Fehler">
                      <Setter TargetName="Box" Property="Background" Value="#FFEBEE" />
                      <Setter TargetName="Box" Property="BorderBrush" Value="Firebrick" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding SeverityText}" Value="Hinweis">
                      <Setter TargetName="Box" Property="Background" Value="#F5F5F5" />
                      <Setter TargetName="Box" Property="BorderBrush" Value="Gray" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                      <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource SelectionAccentBrush}" />
                      <Setter TargetName="Box" Property="BorderThickness" Value="5,2,2,2" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Expander>
        <ListView Grid.Row="3" ItemsSource="{Binding References}">
          <ListView.View>
            <GridView>
              <GridViewColumn Header="Beziehung" Width="150" DisplayMemberBinding="{Binding Relation}" />
              <GridViewColumn Header="Trigger" Width="170">
                <GridViewColumn.CellTemplate>
                  <DataTemplate DataType="viewModels:ReferenceItem">
                    <Button Style="{StaticResource LinkButton}" Content="{Binding OtherName}" Click="OnReferenceClicked"
                            ToolTip="{Binding LineText}" />
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="Zeile" Width="60" DisplayMemberBinding="{Binding LineNumber}" />
            </GridView>
          </ListView.View>
        </ListView>
        <GridSplitter Grid.Row="4" HorizontalAlignment="Stretch" />
        <ListBox x:Name="SectionPreview" Grid.Row="5" ItemsSource="{Binding SelectedSectionLines}" SelectionMode="Extended"
                 MouseDoubleClick="OnSectionPreviewDoubleClick"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 FontFamily="Consolas" HorizontalContentAlignment="Stretch" KeyDown="OnSectionPreviewKeyDown"
                 ToolTip="Strg+C kopiert die markierten Zeilen" ToolTipService.InitialShowDelay="2000">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem" BasedOn="{StaticResource ClearSelectionItem}">
              <Setter Property="Padding" Value="0" />
              <Setter Property="Margin" Value="0" />
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="viewModels:SectionLineItem">
              <Border x:Name="Row" Background="Transparent" BorderThickness="3,0,0,0" BorderBrush="Transparent"
                      ToolTip="{Binding ToolTip}">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Left" Width="48" Text="{Binding NumberText}" Foreground="#9E9E9E"
                             TextAlignment="Right" Margin="0,0,6,0" />
                  <ContentControl DockPanel.Dock="Left" Width="16" Margin="0,0,4,0" VerticalAlignment="Center" Template="{StaticResource SeverityBadge}" />
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="4,1"
                              Visibility="{Binding HasActions, Converter={StaticResource BoolToVisibility}}">
                    <Button Content="Bearbeiten" Padding="6,0" Margin="0,0,4,0" FontFamily="Segoe UI" Click="OnEditSection"
                            ToolTip="Diesen Abschnitt im Textfenster bearbeiten" />
                    <Button Content="Löschen" Padding="6,0" FontFamily="Segoe UI" Click="OnDeleteSection"
                            ToolTip="Diesen Abschnitt aus der Datei entfernen (Strg+Z macht es rückgängig)" />
                  </StackPanel>
                  <TextBlock x:Name="LineText" Text="{Binding Text}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
              </Border>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCaption}" Value="True">
                  <Setter TargetName="Row" Property="Background" Value="#ECEFF1" />
                  <Setter TargetName="Row" Property="Margin" Value="0,6,0,2" />
                  <Setter TargetName="LineText" Property="FontFamily" Value="Segoe UI" />
                  <Setter TargetName="LineText" Property="FontWeight" Value="SemiBold" />
                  <Setter TargetName="LineText" Property="Foreground" Value="#37474F" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasFindings}" Value="True">
                  <Setter TargetName="Row" Property="Background" Value="#FFF8E1" />
                  <Setter TargetName="Row" Property="BorderBrush" Value="#F9A825" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                  <Setter TargetName="Row" Property="Background" Value="#FFEBEE" />
                  <Setter TargetName="Row" Property="BorderBrush" Value="Firebrick" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <GridSplitter Grid.Column="0" Grid.ColumnSpan="5" Grid.Row="1" HorizontalAlignment="Stretch" />

      <!-- Findings -->
      <DockPanel Grid.Column="0" Grid.ColumnSpan="5" Grid.Row="2" Margin="4">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
          <TextBlock Text="Prüfungen – ab" VerticalAlignment="Center" FontWeight="SemiBold" />
          <ComboBox Width="100" Margin="6,0" ItemsSource="{Binding Severities}"
                    DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding MinimumSeverity}" />
          <TextBlock Text="(Doppelklick zeigt die Stelle im Quelltext rechts, bei Duplikaten mit der ersten Definition)" Foreground="Gray" VerticalAlignment="Center" />
        </StackPanel>
        <DataGrid x:Name="FindingsGrid" ItemsSource="{Binding FindingsView}" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="None" MouseDoubleClick="OnFindingDoubleClick"
                  EnableRowVirtualization="True">
          <DataGrid.Resources>
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#CCE4F7" />
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="Black" />
            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#CCE4F7" />
            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="Black" />
          </DataGrid.Resources>
          <DataGrid.RowStyle>
            <Style TargetType="DataGridRow">
              <Setter Property="ToolTip" Value="{Binding FullText}" />
              <Setter Property="BorderThickness" Value="4,0,0,0" />
              <Setter Property="BorderBrush" Value="Transparent" />
              <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                  <Setter Property="BorderBrush" Value="{StaticResource SelectionAccentBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding SeverityText}" Value="Fehler">
                  <Setter Property="Foreground" Value="Firebrick" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SeverityText}" Value="Hinweis">
                  <Setter Property="Foreground" Value="Gray" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </DataGrid.RowStyle>
          <DataGrid.Columns>
            <DataGridTemplateColumn Width="26" CanUserResize="False">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <ContentControl Template="{StaticResource SeverityBadge}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Schwere" Binding="{Binding SeverityText}" Width="70" />
            <DataGridTextColumn Header="Zeile" Binding="{Binding LineNumber}" Width="60" />
            <DataGridTextColumn Header="Prüfung" Binding="{Binding CheckId}" Width="130" />
            <DataGridTextColumn Header="Betreff" Binding="{Binding Subject}" Width="200" />
            <DataGridTextColumn Header="Meldung" Binding="{Binding Message}" Width="*" />
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
