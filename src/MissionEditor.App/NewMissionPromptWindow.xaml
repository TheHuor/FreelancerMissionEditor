<Window x:Class="MissionEditor.App.NewMissionPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="Neue Mission mit KI" Width="680" Height="600" MinWidth="520" MinHeight="460"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
  <DockPanel Margin="28,20,28,24">
    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,16,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="CopyButton" Content="Auftrag kopieren" Click="OnCopy" IsDefault="True" FontWeight="SemiBold" Padding="14,6" Margin="0,0,8,0" />
        <Button Content="Abbrechen" IsCancel="True" Padding="14,6" />
      </StackPanel>
    </Border>
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Neue Mission mit KI" FontSize="24" FontWeight="SemiBold" />
      <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0" LineHeight="20"
                 Text="Beschreibe die Mission. „Auftrag kopieren“ legt einen fertigen Auftrag in die Zwischenablage; füge ihn in Claude oder Codex ein. Der Agent schreibt die Mission, prüft sie mit dem MCP-Server und exportiert sie erst nach deiner Zustimmung." />
      <TextBlock Text="WAS SOLL DIE MISSION TUN?" Foreground="{StaticResource MutedTextBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,18,0,6" />
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom">
      <TextBlock Text="ZIELDATEI (RELATIV ZUM WORKSPACE)" Foreground="{StaticResource MutedTextBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,14,0,6" />
      <TextBox x:Name="TargetBox" FontFamily="Consolas" AutomationProperties.Name="Zieldatei" />
      <CheckBox x:Name="TemplateBox" Margin="0,10,0,0" />
      <TextBlock x:Name="WorkspaceHint" TextWrapping="Wrap" FontSize="12" Margin="0,10,0,0" />
    </StackPanel>
    <TextBox x:Name="DescriptionBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="120"
             AutomationProperties.Name="Beschreibung der Mission"
             ToolTip="z. B.: Start auf Li01_01_base, Flug zu einem Wegpunkt bei Manhattan, drei Piraten greifen an, nach dem Sieg zurück zur Basis." />
  </DockPanel>
</Window>
