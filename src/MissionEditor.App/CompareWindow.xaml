<Window x:Class="MissionEditor.App.CompareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="Mit Datei vergleichen" Width="1100" Height="780" MinWidth="760" MinHeight="520"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
  <DockPanel Margin="24,18,24,20">
    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,14,0,0">
      <DockPanel>
        <TextBlock x:Name="OutcomeText" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="ApplyButton" Content="Ausgewählte übernehmen" Click="OnApply" FontWeight="SemiBold" Padding="14,6" Margin="0,0,8,0"
                  ToolTip="Die angehakten Abschnitte in die Mission übernehmen (Strg+Z im Editor macht es rückgängig, gespeichert wird erst mit Strg+S)" />
          <Button Content="Schließen" IsCancel="True" Click="OnClose" Padding="14,6" />
        </StackPanel>
      </DockPanel>
    </Border>

    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Mit Datei vergleichen" FontSize="22" FontWeight="SemiBold" />
      <TextBlock x:Name="HeaderText" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource MutedTextBrush}" />
    </StackPanel>

    <Grid Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300" MinWidth="220" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <DockPanel Grid.Column="0">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
          <TextBlock Text="ABSCHNITTE" Foreground="{StaticResource MutedTextBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button Content="alle" Click="OnChooseAll" Margin="12,0,0,0" Padding="8,1" FontSize="12" />
          <Button Content="keine" Click="OnChooseNone" Margin="6,0,0,0" Padding="8,1" FontSize="12" />
        </StackPanel>
        <ListBox x:Name="ChangeList" SelectionChanged="OnChangeSelected" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Unterschiede">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <DockPanel Margin="2,3">
                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsChosen}" Checked="OnChoiceChanged" Unchecked="OnChoiceChanged" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding KindText}" Foreground="{Binding KindBrush}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Title}" />
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
      <DockPanel Grid.Column="2">
        <TextBlock DockPanel.Dock="Top" x:Name="BeforeCaption" Text="Jetzt in der Mission" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6" />
        <TextBox x:Name="BeforeBox" IsReadOnly="True" FontFamily="Consolas" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
      </DockPanel>
      <DockPanel Grid.Column="4">
        <TextBlock DockPanel.Dock="Top" x:Name="AfterCaption" Text="In der anderen Datei" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6" />
        <TextBox x:Name="AfterBox" IsReadOnly="True" FontFamily="Consolas" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
